{
  "name": "@blueriverlhr/dsh-better-webui",
  "description": "DeepSeek Harness Web GUI 增强插件 monorepo 元包：聚合多个解耦的功能小包。安装本包即挂上全部功能，每个功能也可单独安装（详见各包 README）。",
  "version": "0.21.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@blueriverlhr/dsh-better-webui-archive": "file:./packages/archive",
    "@blueriverlhr/dsh-better-webui-bashguard": "file:./packages/bashguard",
    "@blueriverlhr/dsh-better-webui-chime": "file:./packages/chime",
    "@blueriverlhr/dsh-better-webui-modelparams": "file:./packages/modelparams",
    "@blueriverlhr/dsh-better-webui-reasoning": "file:./packages/reasoning",
    "@blueriverlhr/dsh-better-webui-retry": "file:./packages/retry",
    "@blueriverlhr/dsh-better-webui-search": "file:./packages/search",
    "@blueriverlhr/dsh-better-webui-settings": "file:./packages/settings"
  },
  "files": [
    "cordis.patch.yml",
    "packages/",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node tests/run-all.mjs",
    "test:composition": "node tests/composition.mjs"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@deepseek-ai/dsh-web": "^0.1.0-rc.7",
    "jsdom": "^30.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
