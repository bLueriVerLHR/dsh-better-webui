{
  "name": "@blueriverlhr/dsh-better-webui",
  "description": "Web GUI enhancement plugin, monorepo meta bundle: aggregating five decoupled feature packages (archive-session management / custom-model reasoning provisioning / session activity chimes / keyless Exa web search / persistent-bash stall guard). Installing this bundle mounts every feature; each feature is also installable on its own.",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@blueriverlhr/dsh-better-webui-archive": "file:./packages/archive",
    "@blueriverlhr/dsh-better-webui-bashguard": "file:./packages/bashguard",
    "@blueriverlhr/dsh-better-webui-chime": "file:./packages/chime",
    "@blueriverlhr/dsh-better-webui-reasoning": "file:./packages/reasoning",
    "@blueriverlhr/dsh-better-webui-search": "file:./packages/search"
  },
  "files": [
    "cordis.patch.yml",
    "packages/",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node tests/run-all.mjs",
    "test:composition": "node tests/composition.mjs"
  },
  "license": "GPL-3.0",
  "devDependencies": {
    "@deepseek-ai/dsh-web": "^0.1.0-rc.7",
    "jsdom": "^30.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
